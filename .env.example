# Copy this file to .env and set your own values.
# Never commit real secrets to Git.

APP_NAME=AI Hub
APP_VERSION=1.0.0
API_V1_PREFIX=/api/v1
DEBUG=false
HOST=127.0.0.1
PORT=8000
MAX_UPLOAD_MB=10

# Generate a unique secret of at least 32 characters.
# Example PowerShell command:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
AI_HUB_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS

# Optional paths. Defaults are managed by the application.
# AI_HUB_DATABASE_PATH=artifacts/ai_hub.sqlite3
# AI_HUB_UPLOAD_DIR=uploads
# UPLOAD_DIR=uploads
# DATA_DIR=data
# LOG_DIR=logs
# LOG_LEVEL=INFO

# Optional local model paths. No model downloads happen automatically.
# AI_HUB_LLM_MODEL_PATH=models/llm
# AI_HUB_VISION_MODEL_PATH=ai_models
# AI_HUB_SPEECH_MODEL_PATH=models/speech
# AI_HUB_EMBEDDING_MODEL_PATH=models/embeddings
AI_HUB_DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@127.0.0.1:5432/ai_hub
